rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function primaryProfilePath() {
      return /databases/$(database)/documents/userProfiles/$(request.auth.uid);
    }

    function alternateProfilePath() {
      return /databases/$(database)/documents/Usuarios/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn()
        && (exists(primaryProfilePath()) || exists(alternateProfilePath()));
    }

    function profile() {
      return exists(primaryProfilePath())
        ? get(primaryProfilePath()).data
        : get(alternateProfilePath()).data;
    }

    function hasStoreRole(storeId) {
      return hasProfile()
        && profile().storeId == storeId
        && profile().role in [
          'owner',
          'manager',
          'purchasing',
          'kitchen_bar'
        ];
    }

    function isSuperAdmin() {
      return hasProfile() && profile().role == 'super_admin';
    }

    function canAccessStore(storeId) {
      return isSuperAdmin() || hasStoreRole(storeId);
    }

    function canReviewNewItems(storeId) {
      return isSuperAdmin()
        || (
          hasProfile()
          && profile().storeId == storeId
          && profile().role in ['owner', 'manager']
        );
    }

    function canUseStorePurchaseList(storeId) {
      return canAccessStore(storeId)
        && profile().role in [
          'super_admin',
          'owner',
          'manager',
          'purchasing',
          'kitchen_bar'
        ];
    }

    function canManageStore(storeId) {
      return canAccessStore(storeId)
        && profile().role in ['super_admin', 'owner', 'manager'];
    }

    function canRecordPurchases(storeId) {
      return canAccessStore(storeId)
        && profile().role in [
          'super_admin',
          'owner',
          'manager',
          'purchasing'
        ];
    }

    function canImportWeeklySales(storeId) {
      return canAccessStore(storeId)
        && profile().role in ['super_admin', 'owner', 'manager', 'purchasing'];
    }

    function canReadFinancialData(storeId) {
      return canAccessStore(storeId)
        && profile().role in ['super_admin', 'owner', 'manager', 'purchasing'];
    }

    function storeIdUnchanged() {
      return request.resource.data.storeId == resource.data.storeId;
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /Usuarios/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /stores/{storeId} {
      allow read: if canAccessStore(storeId);
      allow create, update, delete: if canManageStore(storeId);
    }

    match /stores/{storeId}/purchaseLists/{listId} {
      allow read: if canUseStorePurchaseList(storeId)
        && (
          !exists(
            /databases/$(database)/documents/stores/$(storeId)/purchaseLists/$(listId)
          )
          || resource.data.storeId == storeId
        );
      allow create: if canUseStorePurchaseList(storeId)
        && request.resource.data.keys().hasOnly([
          'storeId',
          'status',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.status == 'open'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /items/{itemId} {
        function parentListIsOpen() {
          return get(
            /databases/$(database)/documents/stores/$(storeId)/purchaseLists/$(listId)
          ).data.status == 'open';
        }

        allow read: if canUseStorePurchaseList(storeId)
          && parentListIsOpen();

        allow create: if canUseStorePurchaseList(storeId)
          && parentListIsOpen()
          && request.resource.data.keys().hasAll([
            'nome',
            'quantidade',
            'unidade',
            'categoria',
            'insumoId',
            'novoItem',
            'origem',
            'status',
            'observacao',
            'criadoPor',
            'criadoPorEmail',
            'criadoEm'
          ])
          && request.resource.data.keys().hasOnly([
            'nome',
            'quantidade',
            'unidade',
            'categoria',
            'insumoId',
            'novoItem',
            'origem',
            'status',
            'observacao',
            'criadoPor',
            'criadoPorEmail',
            'criadoEm'
          ])
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0
          && request.resource.data.nome.size() <= 150
          && request.resource.data.quantidade is number
          && request.resource.data.quantidade > 0
          && request.resource.data.unidade is string
          && request.resource.data.unidade.size() > 0
          && request.resource.data.categoria is string
          && request.resource.data.observacao is string
          && request.resource.data.observacao.size() <= 500
          && request.resource.data.categoria.size() <= 100
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoPorEmail == request.auth.token.email
          && request.resource.data.criadoEm == request.time
          && request.resource.data.origem in ['manual', 'automatico']
          && (
            (
              request.resource.data.novoItem == true
              && request.resource.data.status == 'pending_approval'
              && request.resource.data.insumoId == ''
            )
            || (
              request.resource.data.novoItem == false
              && request.resource.data.status == 'requested'
              && request.resource.data.insumoId is string
              && exists(
                /databases/$(database)/documents/insumos/$(request.resource.data.insumoId)
              )
              && request.resource.data.nome == get(
                /databases/$(database)/documents/insumos/$(request.resource.data.insumoId)
              ).data.nome
              && get(
                /databases/$(database)/documents/insumos/$(request.resource.data.insumoId)
              ).data.storeId == storeId
              && request.resource.data.categoria == get(
                /databases/$(database)/documents/insumos/$(request.resource.data.insumoId)
              ).data.categoria
              && request.resource.data.unidade == get(
                /databases/$(database)/documents/insumos/$(request.resource.data.insumoId)
              ).data.unidade
            )
          );

        allow update: if parentListIsOpen()
          && (
            (
              canReviewNewItems(storeId)
              && resource.data.novoItem == true
              && resource.data.status == 'pending_approval'
              && request.resource.data.status in ['approved', 'rejected']
              && request.resource.data.revisadoPor == request.auth.uid
              && request.resource.data.revisadoPorEmail == request.auth.token.email
              && request.resource.data.revisadoEm == request.time
              && request.resource.data.decisao is string
              && request.resource.data.decisao.size() <= 500
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'revisadoPor',
                'revisadoPorEmail',
                'revisadoEm',
                'decisao'
              ])
            )
            || (
              canRecordPurchases(storeId)
              && request.resource.data.status == resource.data.status
              && request.resource.data.comentarioCompras is string
              && request.resource.data.comentarioCompras.size() <= 500
              && (
                !request.resource.data.keys().hasAny(['valorUnitario'])
                || request.resource.data.valorUnitario == null
                || (
                  request.resource.data.valorUnitario is number
                  && request.resource.data.valorUnitario >= 0
                )
              )
              && (
                !request.resource.data.keys().hasAny(['valorTotal'])
                || request.resource.data.valorTotal == null
                || (
                  request.resource.data.valorTotal is number
                  && request.resource.data.valorTotal >= 0
                )
              )
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'comentarioCompras',
                'valorUnitario',
                'valorTotal'
              ])
              && request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'comentarioCompras',
                'valorUnitario',
                'valorTotal'
              ])
            )
            || (
              canRecordPurchases(storeId)
              && resource.data.status in ['requested', 'approved']
              && request.resource.data.status == 'purchased'
              && request.resource.data.compradoPor == request.auth.uid
              && request.resource.data.compradoPorEmail == request.auth.token.email
              && request.resource.data.compradoEm == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'compradoPor',
                'compradoPorEmail',
                'compradoEm'
              ])
            )
          );
        allow delete: if false;
      }
    }

    match /stores/{storeId}/weeklySales/{weekStart} {
      allow read: if canUseStorePurchaseList(storeId);
      allow create, update: if canImportWeeklySales(storeId)
        && request.resource.data.keys().hasOnly([
          'storeId',
          'semanaInicio',
          'itens',
          'importadoPor',
          'importadoPorEmail',
          'importadoEm'
        ])
        && request.resource.data.storeId == storeId
        && request.resource.data.semanaInicio == weekStart
        && weekStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 300
        && request.resource.data.importadoPor == request.auth.uid
        && request.resource.data.importadoPorEmail == request.auth.token.email
        && request.resource.data.importadoEm == request.time;
      allow delete: if false;
    }

    match /insumos/{insumoId} {
      allow read: if canAccessStore(resource.data.storeId);
      allow create, update, delete: if false;
    }

    match /insumoFinancas/{insumoId} {
      allow read: if canReadFinancialData(resource.data.storeId);
      allow write: if false;
    }

    match /fichasTecnicas/{fichaId} {
      allow read: if canAccessStore(resource.data.storeId);
      allow create, update, delete: if false;
    }

    match /fichaTecnicaFinancas/{fichaId} {
      allow read: if canReadFinancialData(resource.data.storeId);
      allow write: if false;
    }

    match /produtoCustos/{produtoId} {
      allow read: if canReadFinancialData(resource.data.storeId);
      allow write: if false;
    }

    match /produtos/{produtoId} {
      allow read: if resource.data.disponivel == true
        || canAccessStore(resource.data.storeId);
      allow create: if canManageStore(request.resource.data.storeId)
        && request.resource.data.keys().hasOnly([
          'storeId',
          'nome',
          'descricao',
          'categoriaId',
          'categoriaNome',
          'preco',
          'disponivel',
          'imagemUrl',
          'fichaTecnicaId',
          'destaque',
          'ordem',
          'atualizadoEm'
        ]);
      allow update: if canManageStore(resource.data.storeId)
        && storeIdUnchanged()
        && request.resource.data.keys().hasOnly([
          'storeId',
          'nome',
          'descricao',
          'categoriaId',
          'categoriaNome',
          'preco',
          'disponivel',
          'imagemUrl',
          'fichaTecnicaId',
          'destaque',
          'ordem',
          'atualizadoEm'
        ]);
      allow delete: if canManageStore(resource.data.storeId);
    }

    match /categorias/{categoriaId} {
      allow read: if true;
      allow create: if canManageStore(request.resource.data.storeId);
      allow update: if canManageStore(resource.data.storeId)
        && storeIdUnchanged();
      allow delete: if canManageStore(resource.data.storeId);
    }

    match /signage/{playlistId} {
      allow read: if resource.data.publico == true
        || canAccessStore(resource.data.storeId);
      allow create: if canManageStore(request.resource.data.storeId);
      allow update: if canManageStore(resource.data.storeId)
        && storeIdUnchanged();
      allow delete: if canManageStore(resource.data.storeId);
    }

    match /compras/{compraId} {
      allow read: if canRecordPurchases(resource.data.storeId);
      allow create, update, delete: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if canRecordPurchases(resource.data.storeId);
      allow create, update, delete: if false;
    }

    match /items/{itemId} {
      allow create: if canRecordPurchases(request.resource.data.storeId)
        && request.resource.data.usuarioId == request.auth.uid;
      allow read: if canRecordPurchases(resource.data.storeId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
